package kr.swdl.model;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;

import javax.management.Query;

public class CustomerDAO {
	private Connection conn;

	// 원하는 대로 추가 -> 오버 로딩 ==> 메모리에서 처리
	// 디폴트 생성자 쓰면 안됨 conn을 전달받아야하므로 (Service)
	public CustomerDAO(Connection conn) { // 1번째 방법
		this.conn = conn;
	}
	
	// 현재 등록된 고객의 번호가 필요 
		// dao는 왔다갔다 하면 x
		public int getCustomerId() {
			int customerId=0;
			try {
				Statement stmt = conn.createStatement();
				ResultSet rs = stmt.executeQuery(Query.GET_CUSTMER_ID);
				rs.next();
				customerId=rs.getInt(customerId);
				rs.close();
				stmt.close();
			} catch (SQLException e) {
				e.printStackTrace();
			}
			
			return customerId;
		}
		
		public boolean updateCustmerPoint(int custmoerId, int point) {
			
			return false;
		}
	
	
	
	public boolean addCustomer(String name, String phoneNumber) {
		boolean result = false;
		try {
			PreparedStatement pstmt = conn.prepareStatement(Query.ADD_CUSTOMER);
			pstmt.setString(1, name);
			pstmt.setString(2, phoneNumber);
			result=pstmt.executeUpdate()==1;
			pstmt.close();
		} catch (SQLException e) {
			e.printStackTrace();
		}
		return result;
	}
	

	public String getCustomer(int customerId) {
		String name = null;
		try {
			PreparedStatement pstmt = conn.prepareStatement(Query.GET_CUSTOMER);
			pstmt.setInt(1, customerId);
			ResultSet rs = pstmt.executeQuery();
			if (rs.next()) {
				name = rs.getString(1);
			}
			rs.close();
			pstmt.close();
		} catch (SQLException e) {
			e.printStackTrace();
		}
		return name;
	}
}
