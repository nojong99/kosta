<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>재고 목록 조회</title>

<!-- Bootstrap -->
<link
	href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
	rel="stylesheet">

<!-- Bootstrap Icons -->
<link rel="stylesheet"
	href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

<style>
body {
	background-color: #f5f6f8;
}

.inventory-page {
	padding: 30px;
}

/* 검색 영역 */
.search-area {
	width: 30%;
	min-width: 400px;
}

.search-box {
	background-color: white;
	border: 1px solid #dee2e6;
	border-radius: 10px;
	padding: 20px;
}

/* 날짜 */
.current-date {
	font-size: 15px;
	color: #6c757d;
	font-weight: 500;
}

/* 재고 상태 */
.stock-status {
	margin-top: 15px;
}

.stock-status label {
	margin-right: 20px;
	cursor: pointer;
}

/* 목록 */
.inventory-table-area {
	margin-top: 25px;
	background-color: white;
	border-radius: 10px;
	overflow-x: auto;
	border: 1px solid #dee2e6;
}

.inventory-table {
	margin-bottom: 0;
	min-width: 1200px;
}

.inventory-table th {
	background-color: #f8f9fa;
	text-align: center;
	white-space: nowrap;
	vertical-align: middle;
}

.inventory-table td {
	text-align: center;
	vertical-align: middle;
	white-space: nowrap;
}

/* 폐기 상태 */
.disposed {
	color: #dc3545;
	font-weight: 600;
}

/* 판매중 상태 */
.selling {
	color: #198754;
	font-weight: 600;
}

/* 페이지네이션 */
.pagination-area {
	margin-top: 25px;
	display: flex;
	justify-content: center;
}
</style>
</head>

<body>

	<header>
		<nav class="navbar navbar-expand-lg bg-white border-bottom px-4">

			<div class="container-fluid">
				<a class="navbar-brand fw-bold me-4" href="index.html"> <i
					class="bi bi-house-door-fill me-2"></i> 최강 ERP
				</a>
				<ul class="navbar-nav flex-grow-1 mb-2 mb-lg-0">

					<li class="nav-item dropdown flex-fill text-center"><a
						class="nav-link dropdown-toggle" href="#" role="button"
						data-bs-toggle="dropdown"> 폐기량 동향 </a>

						<ul class="dropdown-menu">

							<li><a class="dropdown-item" href="#"> </a></li>

						</ul></li>

					<li class="nav-item dropdown flex-fill text-center"><a
						class="nav-link dropdown-toggle" href="#" role="button"
						data-bs-toggle="dropdown"> 재고 목록 조회 </a>
						<ul class="dropdown-menu">

							<li><a class="dropdown-item" href="#"> </a></li>

						</ul></li>
					<li class="nav-item dropdown flex-fill text-center"><a
						class="nav-link dropdown-toggle" href="#" role="button"
						data-bs-toggle="dropdown"> 회원 가입 요청 조회 </a>

						<ul class="dropdown-menu">

							<li><a class="dropdown-item" href="#"> </a></li>

						</ul></li>



				</ul>
				
				<div class="dropdown">

					<button class="btn dropdown-toggle" data-bs-toggle="dropdown">

						<i class="bi bi-person-circle me-1"></i> 폐기량 동향 조회 권한을 가진 박관리자

					</button>


					<ul class="dropdown-menu dropdown-menu-end">

						<li><a class="dropdown-item" href="#"> 프로필 </a></li>

						<li><a class="dropdown-item" href="#"> 설정 </a></li>

						<li>
							<hr class="dropdown-divider">
						</li>

						<li><a class="dropdown-item" href="#"> 로그아웃 </a></li>

					</ul>

				</div>
				<div class="current-date me-3">
					<i class="bi bi-calendar3 me-1"></i> <span id="currentDate">2026-09-23</span>
				</div>
			</div>

		</nav>
	</header>


	<main class="inventory-page">

		<!-- 제목 -->
		<div class="mb-4">
			<h3 class="fw-bold mb-1">재고 목록 조회</h3>
			<p class="text-secondary mb-0">상품 및 협동조합별 재고를 조회할 수 있습니다.</p>
		</div>


		<!-- 검색 영역 -->
		<div class="d-flex justify-content-between align-items-start">

			<!-- 왼쪽 검색 -->
			<div class="search-area">

				<div class="search-box">

					<div class="input-group">

						<!-- 검색 조건 -->
						<select class="form-select" style="max-width: 130px;">
							<option value="product">상품명</option>
							<option value="coop">협동조합명</option>
						</select>

						<!-- 검색어 -->
						<input type="text" class="form-control" placeholder="검색어 입력">

						<!-- 검색 버튼 -->
						<button class="btn btn-dark">
							<i class="bi bi-search"></i>
						</button>

					</div>

				</div>


				<!-- 재고 상태 -->
				<div class="stock-status">

					<label> <input type="checkbox"
						class="form-check-input me-1" id="disposed"> 폐기재고
					</label> <label> <input type="checkbox"
						class="form-check-input me-1" id="selling"> 판매중인재고
					</label>

				</div>

			</div>


			<!-- 현재 날짜 -->
			<div class="current-date">
				<i class="bi bi-calendar3 me-1"></i> <span id="currentDate"></span>
			</div>

		</div>


		<!-- 재고 목록 -->
		<div class="inventory-table-area">

			<table class="table table-hover inventory-table">

				<thead>

					<tr>
						<th>순번</th>
						<th>재고일련번호</th>
						<th>상품명</th>
						<th>재고수량(box)</th>
						<th>단가(1box)</th>
						<th>협동조합명</th>
						<th>보관기간</th>
						<th>폐기일자</th>
						<th>폐기사유</th>
					</tr>

				</thead>

				<tbody>

					<tr>
						<td>1</td>
						<td>INV-00001</td>
						<td>바닐라 아이스크림</td>
						<td>30</td>
						<td>25,000원</td>
						<td>서울협동조합</td>
						<td>30일</td>
						<td>-</td>
						<td>-</td>
					</tr>

					<tr>
						<td>2</td>
						<td>INV-00002</td>
						<td>초코 아이스크림</td>
						<td>15</td>
						<td>28,000원</td>
						<td>경기협동조합</td>
						<td>25일</td>
						<td>-</td>
						<td>-</td>
					</tr>

					<tr>
						<td>3</td>
						<td>INV-00003</td>
						<td>딸기 아이스크림</td>
						<td>8</td>
						<td>30,000원</td>
						<td>서울협동조합</td>
						<td>40일</td>
						<td>2026-09-20</td>
						<td>유통기한 초과</td>
					</tr>

					<tr>
						<td>4</td>
						<td>INV-00004</td>
						<td>민트 아이스크림</td>
						<td>20</td>
						<td>27,000원</td>
						<td>인천협동조합</td>
						<td>18일</td>
						<td>-</td>
						<td>-</td>
					</tr>

				</tbody>

			</table>

		</div>


		<!-- 페이지네이션 -->
		<div class="pagination-area">

			<nav>
				<ul class="pagination">

					<li class="page-item disabled"><a class="page-link" href="#">
							<i class="bi bi-chevron-left"></i>
					</a></li>

					<li class="page-item active"><a class="page-link" href="#">1</a>
					</li>

					<li class="page-item"><a class="page-link" href="#">2</a></li>

					<li class="page-item"><a class="page-link" href="#">3</a></li>

					<li class="page-item"><a class="page-link" href="#">4</a></li>

					<li class="page-item"><a class="page-link" href="#">5</a></li>

					<li class="page-item"><a class="page-link" href="#"> <i
							class="bi bi-chevron-right"></i>
					</a></li>

				</ul>
			</nav>

		</div>

	</main>


	<script>
		// 현재 날짜 표시
		const today = new Date();

		const year = today.getFullYear();
		const month = String(today.getMonth() + 1).padStart(2, '0');
		const day = String(today.getDate()).padStart(2, '0');

		document.getElementById("currentDate").textContent = `${year}-${month}-${day}`;
	</script>

</body>
</html>