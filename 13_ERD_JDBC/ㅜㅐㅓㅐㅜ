CREATE TABLE students (
	student_id varchar2(20) NOT NULL,
	name varchar2(20) NOT NULL,
	total_scores NUMBER(5),
	in_date DATE NOT NULL
);

CREATE UNIQUE INDEX PK_students
	ON students (
		student_id ASC
	);

ALTER TABLE students
	ADD
		CONSTRAINT PK_students
		PRIMARY KEY (
			student_id
		);

CREATE TABLE scores (
	score_no NUMBER NOT NULL,
	subject VARCHAR2(10) NOT NULL,
	score NUMBER(3) NOT NULL,
	student_id varchar2(20) NOT NULL
);

CREATE UNIQUE INDEX PK_scores
	ON scores (
		score_no ASC
	);

ALTER TABLE scores
	ADD
		CONSTRAINT PK_scores
		PRIMARY KEY (
			score_no
		);

ALTER TABLE scores
	ADD
		CONSTRAINT FK_students_TO_scores
		FOREIGN KEY (
			student_id
		)
		REFERENCES students (
			student_id
		);
		
		
