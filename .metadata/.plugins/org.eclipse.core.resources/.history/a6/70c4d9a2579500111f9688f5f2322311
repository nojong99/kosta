// 학생의 정보를 저장하려고 합니다.
// 정보는 학번, 이름, 성별(M, F)이 있습니다.
// 200101001
// 노종현

public class ArrayTest_04 {
	public static void main(String[] args) {
		int StuN = 200101001;
		int Num = 5;
		String[][] studenInfo = new String[3][Num];
		
		studenInfo[0][0]="200101001";
		studenInfo[1][0]="홍길동";
		studenInfo[2][0]="M";
		for (int i = 0; i < studenInfo.length; i++) {
			studenInfo[0][Num]=StuN+++"";
			System.out.println(studenInfo[0][i] +"\t" + studenInfo[1][i] +"\t" + studenInfo[2][i] +"\t");
		}
	}
}
