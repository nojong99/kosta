package kr.swdl.model;

import java.sql.SQLException;
// 불린으로 던지기로함
public class CustomerService {
	/**일반적으로 회원 가입 - 포인트 없음.*/
	public boolean addCustomer(String name, String phoneNo) {
		try {
			return new CustomerDAO(DBCP.getConnection()).addCustomer(name, phoneNo);
		} catch (SQLException e) {
			e.printStackTrace();
		}
		return false;
	}
	
	/** 이벤트 기간에는 특정 포인트를 회원 등록 시 부여 */
	
}
