@charset "UTF-8";


body {
    background-color: #f5f6f8;
}

/* 사이드바 */
.sidebar {
    width: 250px;
    min-height: 100vh;
    background-color: #212529;
    position: fixed;
    left: 0;
    top: 0;
}

.sidebar .logo {
    height: 70px;
    display: flex;
    align-items: center;
    padding: 0 25px;
    font-size: 20px;
    font-weight: bold;
    color: white;
}

.sidebar .nav-link {
    color: #adb5bd;
    padding: 12px 25px;
}

.sidebar .nav-link:hover,
.sidebar .nav-link.active {
    color: white;
    background-color: #343a40;
}

.sidebar .nav-link i {
    margin-right: 10px;
}

/* 메인 */
.main {
    margin-left: 250px;
    min-height: 100vh;
}

/* 상단바 */
.topbar {
    height: 70px;
    background-color: white;
    border-bottom: 1px solid #dee2e6;
}

/* 카드 */
.dashboard-card {
    border: none;
    border-radius: 10px;
}

.dashboard-icon {
    width: 45px;
    height: 45px;
    border-radius: 10px;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 20px;
}

/* 차트 영역 */
.chart-area {
    height: 300px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #adb5bd;
    background-color: #fafafa;
    border-radius: 8px;
}

/* 빈 데이터 */
.empty-data {
    height: 150px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #adb5bd;
}

@media (max-width: 768px) {

    .sidebar {
        width: 70px;
    }

    .sidebar .logo span,
    .sidebar .nav-link span {
        display: none;
    }

    .sidebar .nav-link {
        text-align: center;
        padding: 15px 0;
    }

    .sidebar .nav-link i {
        margin: 0;
    }

    .main {
        margin-left: 70px;
    }

}

